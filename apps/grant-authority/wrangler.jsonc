// The grant-issuing authority. NOT PUBLIC: `workers_dev: false`, reachable only
// through the scribe worker's AUTHORITY service binding. This Worker holds K(L)
// of both authority logs — possession is the power to mint arbitrary writer
// credentials under the demo's forest — so it should never have a public URL,
// and GRANT_AUTHORITY_TOKEN is mandatory on top of that.
//
// Secrets (AUTHORITY_ES256_JWK, GRANT_AUTHORITY_TOKEN, COORDINATOR_APP_TOKEN)
// come from .dev.vars locally and `wrangler secret put --env <env>` in CI.
//
// `nodejs_compat` is kept only so @forestrie/grant-builder's barrel export
// resolves — its index re-exports the Node-only es256-pem-grant module, whose
// top-level `node:crypto` import would otherwise fail. That function is never
// called here; src/sign-grant.ts is the WebCrypto replacement.
{
	"$schema": "node_modules/wrangler/config-schema.json",
	// Preview URLs are enabled by DEFAULT whenever workers.dev is on, and each is
	// a second public hostname for the same Worker. For a bound service that
	// would undo workers_dev:false entirely. Off explicitly.
	"preview_urls": false,

	"name": "thinker-grant-authority",
	"main": "src/index.ts",
	"compatibility_date": "2026-01-28",
	"compatibility_flags": ["nodejs_compat"],
	"workers_dev": false,

	"observability": {
		"enabled": true
	},

	// Replaces the local service's 600s setInterval lease renewer. Just-in-time
	// renewal before each issuance is what actually protects a turn; this is the
	// backstop that keeps leases alive while the demo is idle.
	"triggers": {
		"crons": ["*/10 * * * *"]
	},

	// Local `wrangler dev` only (scripts/authority.sh). The id is a placeholder:
	// unsuffixed `wrangler dev` keeps KV in local storage and never resolves it,
	// and this Worker is never deployed without --env. The binding must exist all
	// the same — issuance reads the in-flight record before it registers.
	"kv_namespaces": [{ "binding": "AUTHORITY", "id": "local-dev-placeholder" }],

	"vars": {},

	"env": {
		"dev": {
			"name": "thinker-grant-authority-dev",
			"workers_dev": false,
			"kv_namespaces": [{ "binding": "AUTHORITY", "id": "2d54be9c0f42455eb14bc9765d8276cd" }],
			"triggers": { "crons": ["*/10 * * * *"] },
			"vars": {}
		},
		"stage": {
			"name": "thinker-grant-authority-stage",
			"workers_dev": false,
			"kv_namespaces": [{ "binding": "AUTHORITY", "id": "28b09f802ebc42d6b734f8ea1f937f73" }],
			"triggers": { "crons": ["*/10 * * * *"] },
			"vars": {}
		}
	}
}
