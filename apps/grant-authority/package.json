{
	"name": "grant-authority",
	"version": "0.0.1",
	"private": true,
	"type": "module",
	"description": "The M5 grant-issuing authority as a Cloudflare Worker: holds K(L) of both authority logs and issues creation grants endorsing agent kids and user wallet addresses",
	"scripts": {
		"dev": "wrangler dev",
		"deploy": "wrangler deploy",
		"build": "wrangler deploy --dry-run --outdir dist",
		"typecheck": "tsc -p tsconfig.json",
		"test": "vitest run"
	},
	"dependencies": {
		"@forestrie/encoding": "^0.6.0",
		"@forestrie/grant-builder": "^0.4.0",
		"@forestrie/scrapi-client": "^0.1.3",
		"@forestrie/think-scribe": "workspace:*"
	},
	"devDependencies": {
		"@cloudflare/workers-types": "^4.20250801.0",
		"typescript": "^5.7.0",
		"vitest": "^3.2.4",
		"wrangler": "^4.0.0"
	}
}
