# Prettier already honours the ROOT .gitignore (node_modules/, dist/, .wrangler/,
# .dev.vars, config/instance.jsonc, config/genesis.cbor, **/test/.out/). This file
# adds what only a NESTED .gitignore covers, or nothing at all does.

# Generated by `svelte-kit sync`. Ignored in apps/scribe-ui/.gitignore, which
# prettier does not read — only the root one.
**/.svelte-kit/

# pnpm owns its own formatting.
pnpm-lock.yaml

# Provisioning material (private keys). .provision/ is gitignored; the hand-made
# backups are not.
.provision/
.provision.bak-*/

# Verbatim assets.
apps/scribe-ui/static/
