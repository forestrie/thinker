{
  "name": "thinker",
  "private": true,
  "description": "Forestrie × Cloudflare Think demo — the Scribe: a per-user Think agent producing a tamper-evident, externally verifiable record of a conversation",
  "scripts": {
    "dev": "pnpm --filter scribe-worker dev",
    "typecheck": "pnpm -r typecheck",
    "deploy": "pnpm --filter scribe-worker deploy"
  },
  "packageManager": "pnpm@10.6.5",
  "engines": {
    "node": ">=22"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "workerd",
      "esbuild"
    ]
  },
  "devDependencies": {
    "@forestrie/encoding": "^0.5.0",
    "@forestrie/grant-builder": "^0.2.1",
    "@forestrie/scrapi-client": "^0.1.3"
  }
}